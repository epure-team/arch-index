#!/usr/bin/env bash
# arch-body-compare — proof of syntactic duplication via body-hash (Arch_index_compare).
# Thin wrapper over the OCaml binary; run `dune build bin/arch_body_compare` (or ./build.sh) first.
HERE="$(cd "$(dirname "$0")" && pwd)"
for cand in "$HERE/bin/arch-body-compare" "$HERE/_build/default/bin/arch_body_compare/arch_body_compare.exe"; do
  [ -x "$cand" ] && exec "$cand" "$@"
done
echo "arch-body-compare: binary not found; run: dune build bin/arch_body_compare" >&2
exit 2
