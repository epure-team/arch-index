#!/usr/bin/env bash
# arch-coverage — reachability-weighted coverage from an LCOV tracefile.
# Thin wrapper over the OCaml binary; run `dune build bin/arch_coverage` (or ./build.sh) first.
HERE="$(cd "$(dirname "$0")" && pwd)"
for cand in "$HERE/bin/arch-coverage" "$HERE/_build/default/bin/arch_coverage/arch_coverage.exe"; do
  [ -x "$cand" ] && exec "$cand" "$@"
done
echo "arch-coverage: binary not found; run: dune build bin/arch_coverage" >&2
exit 2
