#!/usr/bin/env bash
# arch-coverage-load — append a coverage snapshot into the main-schema `coverage` table.
# NOT arch-coverage --write (which replaces the table from an LCOV tracefile); see the OCaml
# doc comment in bin/arch_coverage_load/arch_coverage_load.ml for the distinction.
# Thin wrapper over the OCaml binary; run `dune build bin/arch_coverage_load` (or ./build.sh) first.
HERE="$(cd "$(dirname "$0")" && pwd)"
for cand in "$HERE/bin/arch-coverage-load" "$HERE/_build/default/bin/arch_coverage_load/arch_coverage_load.exe"; do
  [ -x "$cand" ] && exec "$cand" "$@"
done
echo "arch-coverage-load: binary not found; run: dune build bin/arch_coverage_load" >&2
exit 2
