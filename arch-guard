#!/usr/bin/env bash
# Thin dispatcher only: arch-guard never builds or installs its implementation.
set -u
HERE="$(cd "$(dirname "$0")" && pwd)"
for cand in "$HERE/bin/arch_guard/arch_guard" "$HERE/_build/default/bin/arch_guard/arch_guard.exe"; do
  [ -x "$cand" ] && exec "$cand" "$@"
done
echo "arch-guard: binary not found; build arch_guard before invoking this wrapper" >&2
exit 2
