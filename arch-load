#!/usr/bin/env bash
# arch-load — build a ⊤-MARKED arch-index DB from a generic NDJSON call-edge stream.
# Thin wrapper over the OCaml binary; run `dune build bin/arch_load` (or ./build.sh) first.
HERE="$(cd "$(dirname "$0")" && pwd)"
for cand in "$HERE/bin/arch-load" "$HERE/_build/default/bin/arch_load/arch_load.exe"; do
  [ -x "$cand" ] && exec "$cand" "$@"
done
echo "arch-load: binary not found; run: dune build bin/arch_load" >&2
exit 2
