#!/usr/bin/env bash
# arch-query — canned call-graph queries over an arch-index comment_db (SQLite).
#
# Thin wrapper over the OCaml binary, matching the arch-callgraph-ocaml pattern. The
# implementation lives in bin/arch_query/; run `dune build bin/arch_query` (or ./build.sh) first.
#
# ARCH_QUERY_FORMAT=box|list|json|csv|line|markdown selects the output mode (default box).
# Machine consumers should set `list` or `json`.
HERE="$(cd "$(dirname "$0")" && pwd)"
for cand in "$HERE/bin/arch-query" "$HERE/_build/default/bin/arch_query/arch_query.exe"; do
  [ -x "$cand" ] && exec "$cand" "$@"
done
echo "arch-query: binary not found; run: dune build bin/arch_query" >&2
exit 2
