      "skill": "roster-review",
      "inputs": [
        "briefs/ocaml-cfa-foundation-reviewer.md"
      ],
      "outputs": [
        "briefs/ocaml-cfa-foundation-review.json"
      ],
      "hook": false
    },
    {
      "id": "step-3",
      "skill": "roster-qa",
      "inputs": [
        "briefs/ocaml-cfa-foundation-qa-scope.md"
      ],
      "outputs": [
        "briefs/ocaml-cfa-foundation-qa.md"
      ],
      "hook": false
    },
    {
      "id": "step-4",
      "skill": "roster-ship",
      "inputs": [
        "briefs/ocaml-cfa-foundation-review.json",
        "briefs/ocaml-cfa-foundation-qa.md"
