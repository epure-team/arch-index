      "hook": false
    },
    {
      "id": "step-3",
      "skill": "roster-qa",
      "inputs": [
        "briefs/ocaml-cfa-propagation-qa-scope.md",
        "briefs/ocaml-cfa-propagation-review.md"
      ],
      "outputs": ["briefs/ocaml-cfa-propagation-qa.md"],
      "hook": false
    },
    {
      "id": "step-4",
      "skill": "roster-ship",
      "inputs": [
        "briefs/ocaml-cfa-propagation-review.md",
        "briefs/ocaml-cfa-propagation-qa.md"
