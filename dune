(env
 (static
  (link_flags (:standard -ccopt -static -ccopt -no-pie))))

; The recurring-report runner is a Node consumer, but its contract must run in
; the ordinary test alias rather than depending on a manual release ritual.
(rule
 (alias runtest)
 (deps
  scripts/analysis-report-consumer.js
  scripts/analysis-report-consumer-check.js)
 (action (run node scripts/analysis-report-consumer-check.js)))
