#!/usr/bin/env python3
"""Create the final verified public release archive from a staged directory."""
import io,os,subprocess,sys,tarfile
if len(sys.argv) != 4:
    print("usage: package-release DIST SUFFIX ARCHIVE",file=sys.stderr); sys.exit(2)
dist,suffix,archive=sys.argv[1:]
check=os.path.join(os.path.dirname(os.path.abspath(__file__)),"check-release-manifest")
subprocess.run([check,dist,suffix],check=True)
with tarfile.open(archive,"w:gz",format=tarfile.PAX_FORMAT) as tf:
    for name in sorted(os.listdir(dist)):
        path=os.path.join(dist,name)
        if not os.path.isfile(path): continue
        data=open(path,"rb").read(); info=tarfile.TarInfo(name)
        info.size=len(data); info.mode=0o755; info.mtime=0; info.uid=info.gid=0
        info.uname=info.gname=""
        tf.addfile(info,io.BytesIO(data))
subprocess.run([check,archive,suffix],check=True)
