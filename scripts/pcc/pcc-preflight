#!/usr/bin/env bash
# pcc-preflight — the final gate before Commit in the proof-carrying-change workflow: does the
# CURRENT repo's (CWD) test suite pass? See cabal-workflow-runner's
# docs/proof-carrying-change.md, "The pcc-* convention".
#
# Usage: pcc-preflight
#
# Prints {"ok":bool,"tests":int} on stdout. The engine gates on the EXIT CODE alone (per
# round-2 review finding F7 in docs/proof-carrying-change.md) — "ok"/"tests" are receipt data
# for a human reading the ledger, never evaluated as the gate condition. So the exit code MUST
# track the test suite's real pass/fail, and "ok" is kept consistent with it only as a matter
# of not lying in the receipt.
set -uo pipefail

if ! command -v dune >/dev/null 2>&1; then
  echo "pcc-preflight: dune not found on PATH" >&2
  exit 2
fi

build_log="$(mktemp)"
test_log="$(mktemp)"
trap 'rm -f "$build_log" "$test_log"' EXIT

# `--root .`, not a bare `dune build`: dune searches UPWARD for its project root, so a bare
# invocation here builds whatever ancestor directory happens to contain a dune-project — not the
# repo we were pointed at. That is not hypothetical: it silently builds and reports on the WRONG
# project whenever the target is nested under another dune workspace (a vendored subrepo, a
# monorepo subdirectory, or a scratch checkout under a directory that happens to have one).
# It also made this tool's own test fail in any environment with a stray dune-project above /tmp,
# which read as flakiness for a long time. Rooting explicitly is the whole fix.
if ! dune build --root . >"$build_log" 2>&1; then
  cat "$build_log" >&2
  echo "pcc-preflight: dune build failed" >&2
  printf '{"ok": false, "tests": 0}\n'
  exit 1
fi

dune test --root . >"$test_log" 2>&1
rc=$?
cat "$test_log" >&2

# Count test cases from Alcotest's own "N tests run" summary lines (one per test suite; a repo
# can run more than one). Falls back to 0 if the runner used something other than Alcotest —
# "tests" is receipt data, not the gate, so an undercount here never masks a real failure: the
# exit code above already reflects it.
tests="$(grep -oE '[0-9]+ tests? run' "$test_log" | grep -oE '^[0-9]+' | \
  awk '{s+=$1} END {print s+0}')"

if [ "$rc" -eq 0 ]; then
  printf '{"ok": true, "tests": %d}\n' "$tests"
  exit 0
else
  printf '{"ok": false, "tests": %d}\n' "$tests"
  exit 1
fi
