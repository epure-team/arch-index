// specs/mutation-campaign-313.qnt — generated by roster-spec-formal
// Formal model for the executed mutation campaign (roadmap item 3.13).
// Each invariant traces to a parent user story (US-N) from specs/mutation-campaign-313.md.
//
// Scope of the model: the small machine the properties actually live in — a selection set that
// grows, a verdict emitted under a condition, and a report vocabulary that must not promote
// silence into a claim. It does NOT model the engine, the database, or the diff.
//
// P4 (site-key uniqueness) is deliberately absent: it is an empirical fact about a real corpus,
// not a theorem, and is carried by CHECK-9 instead.

module mutation_campaign_313 {

  // A test is identified by its resolved name string. Positional addressing (alcotest's
  // group-plus-index) is an invocation detail, re-resolved each campaign, never identity.
  type Test = str

  // ---------------------------------------------------------------- state

  // The tests the plan says reach the mutated function. A LOWER bound: a MAY_TOP edge is never
  // traversed, so this set can omit a test that really does reach.
  var intended: Set[Test]

  // The tests the driver actually ran. Always a superset of `intended` — never a subset.
  var executed: Set[Test]

  // The previous value of `executed`, so monotonicity is expressible as a state invariant.
  var prevExecuted: Set[Test]

  // Whether the test cone holds no MAY_TOP edge, and whether the index carries a soundness
  // contract. Together they decide the selection provenance.
  var coneClosed: bool
  var indexHasContract: bool

  // What the engine reported for this mutant, and whether it named the killing test.
  var engineStatus: str
  var engineNamedKiller: bool

  // Whether a run row exists for this mutant in this campaign, and whether the campaign finished.
  var runRowWritten: bool
  var campaignCompleted: bool

  // Whether an attribution row (which test killed it) was written.
  var attributionRowWritten: bool

  // ---------------------------------------------------------------- derived

  // FR-012: proved_superset requires BOTH a closed cone and a soundness contract. The two
  // failure modes stay distinct, mirroring arch-rules' UNKNOWN vs UNKNOWN_NO_CONTRACT.
  pure def provenanceOf(closed: bool, contract: bool): str =
    if (not(contract)) "no_contract"
    else if (closed) "proved_superset"
    else "top_bounded"

  // FR-011: the published verdict is computed, never stored. PENDING is the ABSENCE of a run
  // row in an incomplete campaign — it has no slot in the stored vocabulary.
  pure def publishedVerdict(status: str, prov: str, hasRun: bool, completed: bool): str =
    if (not(hasRun)) (if (completed) "MISSING_RUN" else "PENDING")
    else if (status == "KILLED" or status == "TIMEOUT") "KILLED"
    else if (status == "ERROR") "ERROR"
    else if (prov == "proved_superset") "SURVIVED"
    else if (prov == "top_bounded") "UNKNOWN"
    else "UNKNOWN_NO_CONTRACT"

  val provenance: str = provenanceOf(coneClosed, indexHasContract)
  val verdict: str = publishedVerdict(engineStatus, provenance, runRowWritten, campaignCompleted)

  // ---------------------------------------------------------------- actions

  action init: bool = {
    nondet closed = oneOf(Set(true, false))
    nondet contract = oneOf(Set(true, false))
    all {
      intended' = Set("t1", "t2"),
      executed' = Set("t1", "t2"),
      prevExecuted' = Set("t1", "t2"),
      coneClosed' = closed,
      indexHasContract' = contract,
      engineStatus' = "PENDING",
      engineNamedKiller' = false,
      runRowWritten' = false,
      campaignCompleted' = false,
      attributionRowWritten' = false,
    }
  }

  // FR-024: a dynamic proof source (per-test coverage) may ADD a test to the selection.
  // There is deliberately no action that removes one — that absence is what P2 checks, and
  // the mutant in the header comment of scripts/check-quint-red.sh proves the check can fail.
  action addDynamicEvidence: bool = {
    nondet t = oneOf(Set("t3", "t4"))
    all {
      executed' = executed.union(Set(t)),
      prevExecuted' = executed,
      intended' = intended,
      coneClosed' = coneClosed,
      indexHasContract' = indexHasContract,
      engineStatus' = engineStatus,
      engineNamedKiller' = engineNamedKiller,
      runRowWritten' = runRowWritten,
      campaignCompleted' = campaignCompleted,
      attributionRowWritten' = attributionRowWritten,
    }
  }

  // FR-002 / C-1: a profile whose granularity is coarser than one case widens to the group.
  // Widening is sound; narrowing is not.
  action widenToGroup: bool = all {
    executed' = executed.union(Set("t3", "t4", "t5")),
    prevExecuted' = executed,
    intended' = intended,
    coneClosed' = coneClosed,
    indexHasContract' = indexHasContract,
    engineStatus' = engineStatus,
    engineNamedKiller' = engineNamedKiller,
    runRowWritten' = runRowWritten,
    campaignCompleted' = campaignCompleted,
    attributionRowWritten' = attributionRowWritten,
  }

  // FR-007: attribution is written only when the executed set was a singleton, or the engine
  // named the killer. It is never inferred from a larger set.
  action runEngine: bool = {
    nondet s = oneOf(Set("KILLED", "SURVIVED", "TIMEOUT", "ERROR"))
    nondet named = oneOf(Set(true, false))
    all {
      engineStatus' = s,
      engineNamedKiller' = named,
      runRowWritten' = true,
      attributionRowWritten' =
        ((s == "KILLED" or s == "TIMEOUT") and (executed.size() == 1 or named)),
      executed' = executed,
      prevExecuted' = executed,
      intended' = intended,
      coneClosed' = coneClosed,
      indexHasContract' = indexHasContract,
      campaignCompleted' = campaignCompleted,
    }
  }

  action completeCampaign: bool = all {
    campaignCompleted' = true,
    executed' = executed,
    prevExecuted' = executed,
    intended' = intended,
    coneClosed' = coneClosed,
    indexHasContract' = indexHasContract,
    engineStatus' = engineStatus,
    engineNamedKiller' = engineNamedKiller,
    runRowWritten' = runRowWritten,
    attributionRowWritten' = attributionRowWritten,
  }

  action step: bool = any {
    addDynamicEvidence,
    widenToGroup,
    runEngine,
    completeCampaign,
  }

  // ---------------------------------------------------------------- invariants

  // US-3: "A survivor found under a selection that may have been incomplete is reported as
  // unknown rather than as a test gap, so a reviewer is not sent to strengthen a test that was
  // never run."
  // Stated over the PRIMITIVE state, not over `provenance`. Relating the verdict to the
  // provenance would restate publishedVerdict's own definition, and scripts/check-quint-red.sh
  // proved that form vacuous: it stayed green with a defective provenanceOf injected.
  val p1SurvivorNeedsProvedSuperset: bool =
    (runRowWritten and engineStatus == "SURVIVED")
      implies ((verdict == "SURVIVED") iff (coneClosed and indexHasContract))

  // US-3: "A kill is a proof; selection provenance does not weaken it."
  val p1KillIsNeverWeakened: bool =
    (runRowWritten and (engineStatus == "KILLED" or engineStatus == "TIMEOUT"))
      implies (verdict == "KILLED")

  // US-3: the two unknowns stay distinct — an escaped cone is not the same fact as an index
  // that never established soundness at all.
  val p1UnknownsStayDistinct: bool =
    (runRowWritten and engineStatus == "SURVIVED" and not(indexHasContract))
      implies (verdict == "UNKNOWN_NO_CONTRACT")

  // US-6: "A dynamic proof source may only add tests to the selection, never remove any."
  val p2ExecutedNeverShrinks: bool = prevExecuted.subseteq(executed)

  // US-1: "The driver must never invoke the engine with a subset of the intended reaching set."
  val p2ExecutedIsSupersetOfIntended: bool = intended.subseteq(executed)

  // US-2: "The system never invents attribution — a kill row exists only when the executed set
  // was a singleton or the engine named the killer."
  val p3AttributionNeverInvented: bool =
    attributionRowWritten implies (executed.size() == 1 or engineNamedKiller)

  // US-2: attribution is only ever claimed for an actual kill, never for a survivor.
  val p3AttributionOnlyForKills: bool =
    attributionRowWritten implies (engineStatus == "KILLED" or engineStatus == "TIMEOUT")

  // US-2: "PENDING is the absence of a run row, never a stored status."
  val p3PendingIsNeverStored: bool =
    runRowWritten implies (engineStatus != "PENDING")

  // US-2 / US-3: an unattempted mutant in an unfinished campaign reads PENDING, never SURVIVED.
  val p3UnattemptedIsPendingNotSurvived: bool =
    (not(runRowWritten) and not(campaignCompleted)) implies (verdict == "PENDING")

  // US-6 / P2 stated as a genuine TEMPORAL property rather than as a state invariant over a
  // shadow variable. The shadow form below is kept because the simulator can check it cheaply,
  // but it is equivalent only as long as every action maintains the shadow — this form has no
  // such precondition. Checked by `quint verify --temporal`, not by `quint run`.
  temporal p2ExecutedIsMonotoneOverTime =
    always(executed.subseteq(next(executed)))

  // The conjunction the formal gate checks.
  val allInvariants: bool = and {
    p1SurvivorNeedsProvedSuperset,
    p1KillIsNeverWeakened,
    p1UnknownsStayDistinct,
    p2ExecutedNeverShrinks,
    p2ExecutedIsSupersetOfIntended,
    p3AttributionNeverInvented,
    p3AttributionOnlyForKills,
    p3PendingIsNeverStored,
    p3UnattemptedIsPendingNotSurvived,
  }
}
