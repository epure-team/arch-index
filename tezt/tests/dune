; The language servers and `dune` itself are invisible to dune's dependency
; tracking: nothing in the build graph changes when gopls or rust-analyzer is
; upgraded, so a cached green result outlives the toolchain it was produced
; with. `servers.version` closes that hole by recording what is actually
; installed and making the test depend on the recording.
;
; (universe) is what makes the probe re-run on every build — it is dune's marker
; for "this action reads the outside world". The probe itself is three version
; calls; when the output is byte-identical, dune still caches the test, so the
; cost is the probe and not the suite.
;
; Absence is recorded, not fatal: a machine without rust-analyzer writes
; "rust-analyzer: absent" and the tests take their own skip path (or fail under
; ARCH_TEZT_REQUIRE_SERVERS=1, which is that flag's job, not this rule's).
(rule
 (target servers.version)
 (deps (universe))
 (action
  (with-stdout-to
   %{target}
   (progn
    ; The probe is captured first and defaulted, rather than piped into an `||`:
    ; in `prog | head -1 || echo absent` the exit status is HEAD's, which is 0
    ; whatever prog did, so a missing tool recorded as a blank field instead of
    ; "absent" — and a blank field still differs from the next machine's blank
    ; field only by luck.
    (run sh -c "v=$(gopls version 2>/dev/null | head -1); printf 'gopls: %s\n' \"${v:-absent}\"")
    (run sh -c "v=$(rust-analyzer --version 2>/dev/null); printf 'rust-analyzer: %s\n' \"${v:-absent}\"")
    (run sh -c "v=$(typescript-language-server --version 2>/dev/null); printf 'typescript-language-server: %s\n' \"${v:-absent}\"")
    (run sh -c "v=$(dune --version 2>/dev/null); printf 'dune: %s\n' \"${v:-absent}\"")))))

(test
 (name main)
 (libraries arch_tezt tezt arch_index sqlite3)
 (deps
  %{exe:../../bin/arch_callgraph_ocaml/arch_callgraph_ocaml.exe}
  %{exe:../../bin/arch_query/arch_query.exe}
  %{exe:../../bin/arch_index_cli/arch_index_cli.exe}
  %{exe:../../bin/arch_load/arch_load.exe}
  %{exe:../../bin/arch_body_compare/arch_body_compare.exe}
  %{exe:../../bin/arch_coverage_load/arch_coverage_load.exe}
  %{exe:../../bin/arch_curate/arch_curate.exe}
  %{exe:../../bin/arch_coverage/arch_coverage.exe}
  %{exe:../../bin/arch_serve/arch_serve.exe}
  %{exe:../../bin/arch_rules/arch_rules.exe}
  %{exe:../../bin/arch_impact/arch_impact.exe}
  %{exe:../../bin/arch_effects_ocaml/arch_effects_ocaml.exe}
  %{exe:../../bin/arch_effects_load/main.exe}
  ../../effects-schema-migration.sql
  %{exe:../../bin/arch_mutants/arch_mutants.exe}
  %{exe:../../poc/decision-lint/bin/decision_lint.exe}
  ../../architecture-schema.sql
  servers.version))
